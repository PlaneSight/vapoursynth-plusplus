#pragma once

#include "VapourSynthConfig.vxx"
#include "Enumerations.vxx"
#include "Utility.vxx"

struct VideoFormat {
	field(ColorFamily, ColorFamilies::Undefined);
	field(SampleType, SampleTypes::Int);
	field(BitsPerSample, 0);
	field(BytesPerSample, 0);
	field(HorizontalSubsamplingFactor, 0);
	field(VerticalSubsamplingFactor, 0);
	field(PlaneCount, 0);

public:
	static constexpr auto IndeterminateID = std::uint32_t{ 0 };

	static auto& ConstructIndeterminateInstance() {
		static constexpr auto IndeterminateInstance = VideoFormat{};
		return IndeterminateInstance;
	}

	static auto AdjustToStandardLayout(const VideoFormat& FormatReference) {
		return FormatReference;
	}
	static auto AdjustToStandardLayout(const VSVideoFormat& FormatReference) {
		return VideoFormat{
			.ColorFamily = static_cast<ColorFamilies>(FormatReference.colorFamily * 1000000),
			.SampleType = static_cast<SampleTypes>(FormatReference.sampleType),
			.BitsPerSample = FormatReference.bitsPerSample,
			.BytesPerSample = FormatReference.bytesPerSample,
			.HorizontalSubsamplingFactor = FormatReference.subSamplingW,
			.VerticalSubsamplingFactor = FormatReference.subSamplingH,
			.PlaneCount = FormatReference.numPlanes
		};
	}
	static auto AdjustToLegacyLayout(const VideoFormat& FormatReference) {
		return VSVideoFormat{
			.colorFamily = static_cast<int>(FormatReference.ColorFamily) / 1000000,
			.sampleType = static_cast<int>(FormatReference.SampleType),
			.bitsPerSample = FormatReference.BitsPerSample,
			.bytesPerSample = FormatReference.BytesPerSample,
			.subSamplingW = FormatReference.HorizontalSubsamplingFactor,
			.subSamplingH = FormatReference.VerticalSubsamplingFactor,
			.numPlanes = FormatReference.PlaneCount
		};
	}

public:
	auto QueryID() const {
		auto NormalizedColorFamilyTag = static_cast<int>(ColorFamily) / 1000000;
		auto ColorFamilyFlag = (NormalizedColorFamilyTag & 0xF) << 28;
		auto SampleTypeFlag = (static_cast<int>(SampleType) & 0xF) << 24;
		auto BitdepthFlag = (BitsPerSample & 0xFF) << 16;
		auto HorizontalSubsamplingFlag = (HorizontalSubsamplingFactor & 0xFF) << 8;
		auto VerticalSubsamplingFlag = VerticalSubsamplingFactor & 0xFF;
		return static_cast<std::uint32_t>(ColorFamilyFlag | SampleTypeFlag | BitdepthFlag | HorizontalSubsamplingFlag | VerticalSubsamplingFlag);
	}
	explicit operator auto() const {
		using enum ColorFamilies;
		using enum SampleTypes;
		switch (auto QuantizationSuffix = SampleType == Int ? ColorFamily == RGB ? std::to_string(3 * BitsPerSample) : std::to_string(BitsPerSample) : BitsPerSample == 32 ? "S"s : "H"s; ColorFamily) {
			case Gray:
				return "Gray" + std::move(QuantizationSuffix);
			case RGB:
				return "RGB" + std::move(QuantizationSuffix);
			case YUV:
				if (HorizontalSubsamplingFactor == 1 && VerticalSubsamplingFactor == 1)
					return "YUV420P" + std::move(QuantizationSuffix);
				else if (HorizontalSubsamplingFactor == 1 && VerticalSubsamplingFactor == 0)
					return "YUV422P" + std::move(QuantizationSuffix);
				else if (HorizontalSubsamplingFactor == 0 && VerticalSubsamplingFactor == 0)
					return "YUV444P" + std::move(QuantizationSuffix);
				else if (HorizontalSubsamplingFactor == 2 && VerticalSubsamplingFactor == 2)
					return "YUV410P" + std::move(QuantizationSuffix);
				else if (HorizontalSubsamplingFactor == 2 && VerticalSubsamplingFactor == 0)
					return "YUV411P" + std::move(QuantizationSuffix);
				else if (HorizontalSubsamplingFactor == 0 && VerticalSubsamplingFactor == 1)
					return "YUV440P" + std::move(QuantizationSuffix);
				else [[unlikely]]
					return "YUV with HorizontalSubsamplingFactor = " + std::to_string(HorizontalSubsamplingFactor) + ", VerticalSubsamplingFactor = " + std::to_string(VerticalSubsamplingFactor) + ", QuantizationScheme = " + (SampleType == Int ? "Int" : "Float") + std::to_string(BitsPerSample);
			case Undefined:
				return "Undefined"s;
		[[unlikely]] default:
				throw std::runtime_error{ "VideoFormat: an unrecognized instance has been detected." };
		}
	}

	auto IsSinglePrecision() const {
		return SampleType == SampleTypes::Float && BitsPerSample == 32;
	}
	auto IsRGB() const { return ColorFamily == ColorFamilies::RGB; }
	auto IsGray() const { return ColorFamily == ColorFamilies::Gray; }
	auto IsYUV() const { return ColorFamily == ColorFamilies::YUV; }
	auto Is444() const { return HorizontalSubsamplingFactor == 0 && VerticalSubsamplingFactor == 0; }
};

auto operator==(AnyOf<VideoFormat, VSVideoFormat> auto&& LeftHandSideOperand, AnyOf<VideoFormat, VSVideoFormat> auto&& RightHandSideOperand) {
	auto PrimaryFormat = VideoFormat::AdjustToStandardLayout(LeftHandSideOperand);
	auto ReferenceFormat = VideoFormat::AdjustToStandardLayout(RightHandSideOperand);
	return PrimaryFormat.QueryID() == ReferenceFormat.QueryID();
}

auto operator<=>(AnyOf<VideoFormat, VSVideoFormat> auto&& LeftHandSideOperand, AnyOf<VideoFormat, VSVideoFormat> auto&& RightHandSideOperand) {
	auto PrimaryFormat = VideoFormat::AdjustToStandardLayout(LeftHandSideOperand);
	auto ReferenceFormat = VideoFormat::AdjustToStandardLayout(RightHandSideOperand);
	return PrimaryFormat.QueryID() <=> ReferenceFormat.QueryID();
}

struct AudioFormat {
	field(SampleType, SampleTypes::Int);
	field(BitsPerSample, 0);
	field(BytesPerSample, 0);
	field(ChannelCount, 0);
	field(ChannelLayout, std::uint64_t{ 0 });

	static auto FromAPI(const VSAudioFormat& FormatReference) {
		return AudioFormat{
			.SampleType = static_cast<SampleTypes>(FormatReference.sampleType),
			.BitsPerSample = FormatReference.bitsPerSample,
			.BytesPerSample = FormatReference.bytesPerSample,
			.ChannelCount = FormatReference.numChannels,
			.ChannelLayout = FormatReference.channelLayout
		};
	}
	static auto ToAPI(const AudioFormat& FormatReference) {
		return VSAudioFormat{
			.sampleType = static_cast<int>(FormatReference.SampleType),
			.bitsPerSample = FormatReference.BitsPerSample,
			.bytesPerSample = FormatReference.BytesPerSample,
			.numChannels = FormatReference.ChannelCount,
			.channelLayout = FormatReference.ChannelLayout
		};
	}
};

struct VideoInfo {
	field(Format, VideoFormat{});
	field(FrameRateNumerator, 0_i64);
	field(FrameRateDenominator, 0_i64);
	field(Width, 0);
	field(Height, 0);
	field(FrameCount, 0);

	static auto AdjustToLegacyLayout(const VSVideoInfo& MetadataReference, auto&&...) {
		return MetadataReference;
	}
	static auto AdjustToLegacyLayout(const VideoInfo& MetadataReference, auto&& Core) {
		auto Format = [&] {
			if constexpr (requires { Core.Query(MetadataReference.Format); })
				return Core.Query(MetadataReference.Format);
			else
				return MetadataReference.Format;
		}();
		return VSVideoInfo{
			.format = VideoFormat::AdjustToLegacyLayout(Format),
			.fpsNum = MetadataReference.FrameRateNumerator,
			.fpsDen = MetadataReference.FrameRateDenominator,
			.width = MetadataReference.Width,
			.height = MetadataReference.Height,
			.numFrames = MetadataReference.FrameCount
		};
	}
	static auto FromAPI(const VSVideoInfo& MetadataReference) {
		return VideoInfo{
			.Format = VideoFormat::AdjustToStandardLayout(MetadataReference.format),
			.FrameRateNumerator = MetadataReference.fpsNum,
			.FrameRateDenominator = MetadataReference.fpsDen,
			.Width = MetadataReference.width,
			.Height = MetadataReference.height,
			.FrameCount = MetadataReference.numFrames
		};
	}

	auto WithConstantDimensions() const { return Width != 0 && Height != 0; }
	auto WithConstantFormat() const { return Format.QueryID() != VideoFormat::IndeterminateID; }

	explicit operator auto() const {
		auto StringRepresentation = std::ostringstream{};
		StringRepresentation << "Format: " << static_cast<std::string>(Format) << "\n";
		StringRepresentation << "Resolution: ";
		if (WithConstantDimensions())
			StringRepresentation << Width << " × " << Height << "\n";
		else
			StringRepresentation << "Indeterminate (may vary from frame to frame)\n";
		StringRepresentation << "Frame Rate: ";
		if (FrameRateDenominator != 0 && FrameRateNumerator % FrameRateDenominator == 0)
			StringRepresentation << FrameRateNumerator / FrameRateDenominator << " fps\n";
		else if (FrameRateDenominator != 0)
			StringRepresentation << FrameRateNumerator << " / " << FrameRateDenominator << " ≈ " << std::fixed << std::setprecision(3) << static_cast<long double>(FrameRateNumerator) / FrameRateDenominator << " fps\n";
		else
			StringRepresentation << "Indeterminate\n";
		StringRepresentation << "Frame Count: " << FrameCount;
		return StringRepresentation.str();
	}
};

struct AudioInfo {
	field(Format, AudioFormat{});
	field(SampleRate, 0);
	field(SampleCount, 0_i64);
	field(FrameCount, 0);

	static auto AdjustToLegacyLayout(const VSAudioInfo& MetadataReference, auto&&...) {
		return MetadataReference;
	}
	static auto FromAPI(const VSAudioInfo& MetadataReference) {
		return AudioInfo{
			.Format = AudioFormat::FromAPI(MetadataReference.format),
			.SampleRate = MetadataReference.sampleRate,
			.SampleCount = MetadataReference.numSamples,
			.FrameCount = MetadataReference.numFrames
		};
	}
	static auto AdjustToLegacyLayout(const AudioInfo& MetadataReference, auto&&...) {
		return VSAudioInfo{
			.format = AudioFormat::ToAPI(MetadataReference.Format),
			.sampleRate = MetadataReference.SampleRate,
			.numSamples = MetadataReference.SampleCount,
			.numFrames = MetadataReference.FrameCount
		};
	}
};

struct PluginInfo {
	field(Namespace, ""s);
	field(Identifier, ""s);
	field(Description, ""s);

	explicit operator auto() const {
		auto StringRepresentation = std::ostringstream{};
		StringRepresentation << "Namespace: " << Namespace << "\n";
		StringRepresentation << "Identifier: " << Identifier << "\n";
		StringRepresentation << "Description: " << Description;
		return StringRepresentation.str();
	}
};

struct CoreInfo {
	field(Version, ""sv);
	field(CoreVersion, 0);
	field(APIVersion, 0);
	field(ThreadCount, 0);
	field(MaxFrameBufferSize, 0_i64);
	field(UsedFrameBufferSize, 0_i64);

	explicit operator auto() const {
		auto StringRepresentation = std::ostringstream{};
		StringRepresentation << Version << "\nThread Count: " << ThreadCount << "\n";
		StringRepresentation << "Frame Buffer Size: currently using " << UsedFrameBufferSize << " bytes out of " << MaxFrameBufferSize << " bytes";
		return StringRepresentation.str();
	}
};

namespace AlternateRepresentations::Flattened {
	struct VideoInfo : VideoFormat {
		field(FrameRateNumerator, 0_i64);
		field(FrameRateDenominator, 0_i64);
		field(Width, 0);
		field(Height, 0);
		field(FrameCount, 0);

		auto WithConstantDimensions() const { return Width != 0 && Height != 0; }
		auto WithConstantFormat() const { return QueryID() != IndeterminateID; }
	};
}
