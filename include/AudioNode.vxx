#pragma once
#include "AudioFrame.vxx"
#include "Node.vxx"

struct AudioNode : Node {
	template<typename SampleType>
	auto FetchFrame(std::integral auto Index, auto GeneratorContext) const {
		return AudioFrame<SampleType>{ Node::FetchFrame(Index, GeneratorContext).Leak() };
	}
	template<typename SampleType>
	auto AcquireFrame(std::integral auto Index, auto GeneratorContext) const {
		return AudioFrame<SampleType>{ Node::AcquireFrame(Index, GeneratorContext).Leak() };
	}
};
