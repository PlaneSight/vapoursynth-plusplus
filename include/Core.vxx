#pragma once

#include "Plugin.vxx"
#include "LoggerController.vxx"

struct CoreProxy {
	field(Handle, static_cast<VSCore*>(nullptr));

	auto Query() const {
		auto CoreInfoBuffer = VSCoreInfo{};
		UniversalContext::API->getCoreInfo(Handle, &CoreInfoBuffer);
		return CoreInfo{
			.Version = CoreInfoBuffer.versionString,
			.CoreVersion = CoreInfoBuffer.core,
			.APIVersion = CoreInfoBuffer.api,
			.ThreadCount = CoreInfoBuffer.numThreads,
			.MaxFrameBufferSize = CoreInfoBuffer.maxFramebufferSize,
			.UsedFrameBufferSize = CoreInfoBuffer.usedFramebufferSize
		};
	}
	auto QueryInfo2() const {
		auto CoreInfoBuffer = VSCoreInfo2{};
		UniversalContext::API->getCoreInfo2(Handle, &CoreInfoBuffer);
		return CoreInfo2{
			.Version = CoreInfoBuffer.versionString,
			.CoreVersion = CoreInfoBuffer.coreVersion,
			.APIVersion = CoreInfoBuffer.apiVersion,
			.CreationFlags = CoreInfoBuffer.creationFlags,
			.ThreadCount = CoreInfoBuffer.numThreads,
			.MaxFrameBufferSize = CoreInfoBuffer.maxFramebufferSize,
			.UsedFrameBufferSize = CoreInfoBuffer.usedFramebufferSize
		};
	}
	auto ClearCaches() const -> void {
		UniversalContext::API->clearCoreCaches(Handle);
	}
	auto NodeTimingEnabled() const -> bool {
		return UniversalContext::API->getCoreNodeTiming(Handle) != 0;
	}
	auto SetNodeTiming(bool Enabled) const -> void {
		UniversalContext::API->setCoreNodeTiming(Handle, Enabled ? 1 : 0);
	}
	auto QueryFreedNodeProcessingTime(bool Reset = false) const -> std::int64_t {
		return UniversalContext::API->getFreedNodeProcessingTime(Handle, Reset ? 1 : 0);
	}

	auto Query(AnyOf<VideoFormats> auto FormatID) const {
		auto FormatHandle = VSVideoFormat{};
		if (UniversalContext::API->getVideoFormatByID(&FormatHandle, static_cast<std::uint32_t>(FormatID), Handle) != 0)
			return VideoFormat::AdjustToStandardLayout(FormatHandle);
		return VideoFormat::ConstructIndeterminateInstance();
	}
	auto Query(AnyOf<VideoFormat, VSVideoFormat> auto&& Format) const {
		auto StandardFormat = VideoFormat::AdjustToStandardLayout(Format);
		auto FormatHandle = VSVideoFormat{};
		if (UniversalContext::API->queryVideoFormat(
				&FormatHandle,
				static_cast<int>(StandardFormat.ColorFamily) / 1000000,
				static_cast<int>(StandardFormat.SampleType),
				StandardFormat.BitsPerSample,
				StandardFormat.HorizontalSubsamplingFactor,
				StandardFormat.VerticalSubsamplingFactor,
				Handle) != 0)
			return VideoFormat::AdjustToStandardLayout(FormatHandle);
		return VideoFormat::ConstructIndeterminateInstance();
	}
	auto Query(AnyOf<AudioFormat> auto&& Format) const {
		auto StandardFormat = Format;
		auto FormatHandle = VSAudioFormat{};
		if (UniversalContext::API->queryAudioFormat(
				&FormatHandle,
				static_cast<int>(StandardFormat.SampleType),
				StandardFormat.BitsPerSample,
				StandardFormat.ChannelLayout,
				Handle) != 0)
			return AudioFormat::FromAPI(FormatHandle);
		return AudioFormat{};
	}
	auto Query(std::convertible_to<std::string_view> auto&& PluginIdentifier) const {
		auto Identifier = Utility::ExposeCharPointerIfASCIZCompatibleOrDeepCopyIfNot(PluginIdentifier);
		auto IdentifierPointer = Utility::ExtractCharPointerFromASCIZFormattedString(Identifier);
		auto PluginHandle = UniversalContext::API->getPluginByID(IdentifierPointer, Handle);
		if (PluginHandle == nullptr)
			throw std::runtime_error{ "Query: plugin with the specified identifier was not found." };
		auto Descriptor = PluginInfo{
			.Namespace = UniversalContext::API->getPluginNamespace(PluginHandle),
			.Identifier = UniversalContext::API->getPluginID(PluginHandle),
			.Description = UniversalContext::API->getPluginName(PluginHandle)
		};
		auto Path = UniversalContext::API->getPluginPath(PluginHandle);
		return Plugin{ std::move(Descriptor), PluginHandle, Path == nullptr ? std::filesystem::path{} : std::filesystem::path{ Path } };
	}

	auto AllocateVideoFrame(auto&& Format, std::integral auto Width, std::integral auto Height) const {
		auto StandardFormat = [&] {
			if constexpr (requires { { Query(Format) }->SubtypeOf<VideoFormat>; })
				return Query(Format);
			else
				static_assert(sizeof(Format) == -1, "AllocateVideoFrame: failed to recognize the specified format descriptor.");
		}();
		auto APIFormat = VideoFormat::AdjustToLegacyLayout(StandardFormat);
		return FrameReference{ UniversalContext::API->newVideoFrame(&APIFormat, Width, Height, nullptr, Handle) };
	}
	auto AllocateAudioFrame(const AudioFormat& Format, std::integral auto SampleCount) const {
		auto APIFormat = AudioFormat::ToAPI(Format);
		return FrameReference{ UniversalContext::API->newAudioFrame(&APIFormat, SampleCount, nullptr, Handle) };
	}
	auto CreateBlankFrameFrom(SubtypeOf<FrameReference> auto&& ReferenceFrame) const {
		if constexpr (requires { { ReferenceFrame.ExtractFormat() }->SubtypeOf<VideoFormat>; }) {
			using PixelType = std::decay_t<decltype(ReferenceFrame[0][0][0])>;
			auto StandardFormat = Query(ReferenceFrame.ExtractFormat());
			auto APIFormat = VideoFormat::AdjustToLegacyLayout(StandardFormat);
			return VideoFrame<PixelType>{ UniversalContext::API->newVideoFrame(&APIFormat, ReferenceFrame[0].Width, ReferenceFrame[0].Height, ReferenceFrame.Handle, Handle) };
		}
		else if constexpr (requires { { ReferenceFrame.ExtractFormat() }->SubtypeOf<AudioFormat>; }) {
			using SampleType = std::decay_t<decltype(ReferenceFrame[0][0])>;
			auto APIFormat = AudioFormat::ToAPI(Query(ReferenceFrame.ExtractFormat()));
			return AudioFrame<SampleType>{ UniversalContext::API->newAudioFrame(
				&APIFormat,
				UniversalContext::API->getFrameLength(ReferenceFrame.Handle),
				ReferenceFrame.Handle,
				Handle) };
		}
		else
			return WritableFrame{ UniversalContext::API->copyFrame(ReferenceFrame.Handle, Handle) };
	}
	auto ShufflePlanes(auto&& Frames, auto&& PlaneIndexes, AnyOf<ColorFamilies, VSColorFamily> auto ColorFamily) const {
		auto ValidateInputs = [&](auto& PrimaryFrame, auto PlaneIndex, auto& SubsidiaryPlane1, auto& SubsidiaryPlane2) {
			static_assert(SubtypeOf<decltype(PrimaryFrame), FrameReference>, "ShufflePlanes: specify frames or an iterable frame container.");
			static_assert(requires { { PrimaryFrame.ExtractFormat() }->SubtypeOf<VideoFormat>; }, "ShufflePlanes: specified frames must be video frames.");
			static_assert(Countable<decltype(PlaneIndex)>, "ShufflePlanes: plane index must be an integer.");
			if (SubsidiaryPlane1.Width != SubsidiaryPlane2.Width || SubsidiaryPlane1.Height != SubsidiaryPlane2.Height)
				throw std::runtime_error{ "ShufflePlanes: subsidiary planes have inconsistent dimensions." };
		};
		auto DeduceFormat = [&](auto& ReferenceFormat, auto& PrimaryPlane, auto& SubsidiaryPlane) {
			auto APIColorFamily = [&] {
				if constexpr (std::same_as<std::decay_t<decltype(ColorFamily)>, ColorFamilies>)
					return static_cast<int>(ColorFamily) / 1000000;
				else
					return static_cast<int>(ColorFamily);
			}();
			auto Format = VideoFormat{
				.ColorFamily = static_cast<ColorFamilies>(APIColorFamily * 1000000),
				.SampleType = ReferenceFormat.SampleType,
				.BitsPerSample = ReferenceFormat.BitsPerSample,
				.HorizontalSubsamplingFactor = Utility::Arithmetic::Log2(PrimaryPlane.Width / SubsidiaryPlane.Width),
				.VerticalSubsamplingFactor = Utility::Arithmetic::Log2(PrimaryPlane.Height / SubsidiaryPlane.Height)
			};
			if (SubsidiaryPlane.Width << Format.HorizontalSubsamplingFactor != PrimaryPlane.Width || SubsidiaryPlane.Height << Format.VerticalSubsamplingFactor != PrimaryPlane.Height)
				throw std::runtime_error{ "ShufflePlanes: assembling specified planes leads to an invalid subsampling factor." };
			if (Format.IsRGB() && (Format.HorizontalSubsamplingFactor != 0 || Format.VerticalSubsamplingFactor != 0))
				throw std::runtime_error{ "ShufflePlanes: RGB cannot be subsampled." };
			return VideoFormat::AdjustToLegacyLayout(Query(Format));
		};
		auto&& [Frame1, Frame2, Frame3] = Utility::TypeEraseIterableToTriplet(Forward(Frames));
		auto [x1, x2, x3] = Utility::TypeEraseIterableToTriplet(Forward(PlaneIndexes));
		ValidateInputs(Frame1, x1, Frame2[x2], Frame3[x3]);
		using PixelType = std::decay_t<decltype(Frame1[0][0][0])>;
		auto FormatHandle = DeduceFormat(Frame1.ExtractFormat(), Frame1[x1], Frame2[x2]);
		auto FrameHandles = std::array<const VSFrame*, 3>{ Frame1.Observe(), Frame2.Observe(), Frame3.Observe() };
		auto Specifiers = std::array{ static_cast<int>(x1), static_cast<int>(x2), static_cast<int>(x3) };
		return VideoFrame<PixelType>{ UniversalContext::API->newVideoFrame2(&FormatHandle, Frame1[x1].Width, Frame1[x1].Height, FrameHandles.data(), Specifiers.data(), Frame1.Handle, Handle) };
	}
	auto ShuffleChannels(auto&& Frames, auto&& ChannelIndexes, AudioFormat Format) const -> AudioFrame<void> {
		auto SourceHandles = [&] {
			auto Result = std::vector<const VSFrame*>{};
			if constexpr (Iterable<decltype(Frames)>) {
				for (auto&& Source : Frames) {
					static_assert(SubtypeOf<decltype(Source), FrameReference>, "ShuffleChannels: sources must be audio frame references.");
					Result.push_back(Source.Observe());
				}
			}
			else {
				static_assert(SubtypeOf<decltype(Frames), FrameReference>, "ShuffleChannels: sources must be audio frame references.");
				Result.push_back(Frames.Observe());
			}
			return Result;
		}();
		if (SourceHandles.empty())
			throw std::runtime_error{ "ShuffleChannels: at least one source frame is required." };

		auto RequestedChannels = [&] {
			auto Result = std::vector<int>{};
			if constexpr (Iterable<decltype(ChannelIndexes)>)
				for (auto Channel : ChannelIndexes)
					Result.push_back(static_cast<int>(Channel));
			else
				Result.push_back(static_cast<int>(ChannelIndexes));
			return Result;
		}();
		if (RequestedChannels.empty())
			throw std::runtime_error{ "ShuffleChannels: at least one output channel is required." };
		if (std::ranges::any_of(RequestedChannels, [](auto Channel) { return Channel < 0; }))
			throw std::runtime_error{ "ShuffleChannels: channel indexes must be non-negative." };

		if (Format.ChannelCount == 0)
			Format.ChannelCount = static_cast<int>(RequestedChannels.size());
		if (Format.ChannelCount != static_cast<int>(RequestedChannels.size()))
			throw std::runtime_error{ "ShuffleChannels: output channel count does not match the channel index count." };
		if (Format.ChannelLayout.Count() != 0 && Format.ChannelLayout.Count() != static_cast<std::size_t>(Format.ChannelCount))
			throw std::runtime_error{ "ShuffleChannels: channel layout does not match the output channel count." };
		if (SourceHandles.size() != 1 && SourceHandles.size() != RequestedChannels.size())
			throw std::runtime_error{ "ShuffleChannels: specify one source frame or one source frame per output channel." };
		if (SourceHandles.size() == 1)
			SourceHandles.resize(RequestedChannels.size(), SourceHandles.front());

		const auto SampleCount = UniversalContext::API->getFrameLength(SourceHandles.front());
		for (const auto Source : SourceHandles) {
			if (UniversalContext::API->getFrameType(Source) != mtAudio)
				throw std::runtime_error{ "ShuffleChannels: every source must be an audio frame." };
			if (UniversalContext::API->getFrameLength(Source) != SampleCount)
				throw std::runtime_error{ "ShuffleChannels: source frames must have equal sample counts." };
		}

		auto APIFormat = AudioFormat::ToAPI(Format);
		auto Result = UniversalContext::API->newAudioFrame2(
			&APIFormat,
			SampleCount,
			SourceHandles.data(),
			RequestedChannels.data(),
			SourceHandles.front(),
			Handle);
		if (Result == nullptr)
			throw std::runtime_error{ "ShuffleChannels: failed to allocate the output frame." };
		return AudioFrame<void>{ Result };
	}
	auto ShuffleChannels(auto&& Frames, auto&& ChannelIndexes, AudioChannelLayout Layout) const -> AudioFrame<void> {
		auto Source = [&] {
			if constexpr (Iterable<decltype(Frames)>)
				return *Frames.begin();
			else
				return Frames;
		}();
		if constexpr (requires { Source.QueryAudioFormat(); }) {
			auto Format = Source.QueryAudioFormat();
			Format.ChannelLayout = Layout;
			Format.ChannelCount = static_cast<int>(Layout.Count());
			return ShuffleChannels(Forward(Frames), Forward(ChannelIndexes), Format);
		}
		else {
			static_assert(sizeof(Source) == 0, "ShuffleChannels: unable to infer the source audio format.");
		}
	}
	auto CopyFrame(SubtypeOf<FrameReference> auto&& ReferenceFrame) const {
		auto FrameHandle = UniversalContext::API->copyFrame(ReferenceFrame.Handle, Handle);
		if constexpr (requires { { ReferenceFrame.ExtractFormat() }->SubtypeOf<VideoFormat>; })
			return VideoFrame<std::decay_t<decltype(ReferenceFrame[0][0][0])>>{ FrameHandle };
		else if constexpr (requires { { ReferenceFrame.ExtractFormat() }->SubtypeOf<AudioFormat>; }) {
			using SampleType = std::decay_t<decltype(ReferenceFrame[0][0])>;
			return AudioFrame<SampleType>{ FrameHandle };
		}
		else
			return WritableFrame{ FrameHandle };
	}

	auto Mount(auto&& FunctionEntity) const {
		using FunctionType = std::decay_t<decltype(FunctionEntity)>;
		auto FunctionHandle = new FunctionType{ Forward(FunctionEntity) };
		auto FunctionRecycler = [](void* FunctionPointer) VS_CC { delete static_cast<FunctionType*>(FunctionPointer); };
		auto FunctionProxy = [](const VSMap* InputMap, VSMap* OutputMap, void* FunctionPointer, VSCore* CoreHandle, const VSAPI* API) VS_CC {
			UniversalContext::InstallAPI(API);
			auto Arguments = ArgumentList{ .Handle = InputMap };
			auto Core = CoreProxy{ .Handle = CoreHandle };
			auto& MountedFunction = *static_cast<FunctionType*>(FunctionPointer);
			auto FunctionInvoker = [&] {
				if constexpr (requires { MountedFunction(); })
					return MountedFunction();
				else if constexpr (requires { MountedFunction(Arguments); })
					return MountedFunction(Arguments);
				else if constexpr (requires { MountedFunction(Arguments, Core); })
					return MountedFunction(Arguments, Core);
				else
					static_assert(sizeof(MountedFunction) == -1, "Mount: the specified object has an incompatible signature.");
			};
			try {
				if constexpr (requires { { FunctionInvoker() }->AnyBut<void>; })
					Utility::Map::Item<false>{ OutputMap, "val" } += FunctionInvoker();
				else
					FunctionInvoker();
			}
			catch (const std::exception& ErrorMessage) {
				UniversalContext::API->mapSetError(OutputMap, ErrorMessage.what());
			}
		};
		return Function{ UniversalContext::API->createFunction(FunctionProxy, FunctionHandle, FunctionRecycler, Handle) };
	}

	auto InstallLogger(auto&& MessageLogger) const {
		using LoggerType = std::decay_t<decltype(MessageLogger)>;
		auto LoggerHandle = new LoggerType{ Forward(MessageLogger) };
		auto LoggerRecycler = [](void* LoggerPointer) VS_CC { delete static_cast<LoggerType*>(LoggerPointer); };
		auto LoggerProxy = [](int MessageType, const char* Message, void* LoggerPointer) VS_CC {
			auto& InstalledLogger = *static_cast<LoggerType*>(LoggerPointer);
			if constexpr (requires { InstalledLogger(""sv); })
				InstalledLogger(std::string_view{ Message });
			else if constexpr (requires { InstalledLogger(Message); })
				InstalledLogger(Message);
			else if constexpr (requires { InstalledLogger(MessageTypes::Debug, ""sv); })
				InstalledLogger(static_cast<MessageTypes>(MessageType), std::string_view{ Message });
			else if constexpr (requires { InstalledLogger(MessageTypes::Debug, Message); })
				InstalledLogger(static_cast<MessageTypes>(MessageType), Message);
			else
				static_assert(sizeof(InstalledLogger) == -1, "InstallLogger: the specified logger has an incompatible signature.");
		};
		auto LogHandle = UniversalContext::API->addLogHandler(LoggerProxy, LoggerRecycler, LoggerHandle, Handle);
		return LoggerController{ .Handle = LogHandle, .Core = Handle };
	}
	auto LogMessage(AnyOf<MessageTypes, VSMessageType> auto MessageType, ExplicitlyConvertibleTo<std::string> auto&& Message) const {
		auto FormattedMessage = static_cast<std::string>(Forward(Message));
		UniversalContext::API->logMessage(static_cast<int>(MessageType), FormattedMessage.data(), Handle);
	}
	auto DebugPrint(ExplicitlyConvertibleTo<std::string> auto&& Message) const { LogMessage(MessageTypes::Debug, Forward(Message)); }
	auto Print(ExplicitlyConvertibleTo<std::string> auto&& Message) const { LogMessage(MessageTypes::Information, Forward(Message)); }
	auto Alert(ExplicitlyConvertibleTo<std::string> auto&& Message) const { LogMessage(MessageTypes::Warning, Forward(Message)); }
	auto CriticalAlert(ExplicitlyConvertibleTo<std::string> auto&& Message) const { LogMessage(MessageTypes::Critical, Forward(Message)); }
	auto Abort(ExplicitlyConvertibleTo<std::string> auto&& Message) const { LogMessage(MessageTypes::Fatal, Forward(Message)); }

	auto SetMaxCacheSize(std::integral auto Bytes) const { return UniversalContext::API->setMaxCacheSize(Bytes, Handle); }
	auto SetThreadCount(std::integral auto Threads) const { return UniversalContext::API->setThreadCount(Threads, Handle); }
	auto ListPlugins() const {
		auto PluginDescriptors = std::vector<PluginInfo>{};
		for (VSPlugin* PluginHandle = nullptr; (PluginHandle = UniversalContext::API->getNextPlugin(PluginHandle, Handle)) != nullptr;)
			PluginDescriptors.push_back(PluginInfo{
				.Namespace = UniversalContext::API->getPluginNamespace(PluginHandle),
				.Identifier = UniversalContext::API->getPluginID(PluginHandle),
				.Description = UniversalContext::API->getPluginName(PluginHandle)
			});
		return PluginDescriptors;
	}
	auto operator[](ExplicitlyConvertibleTo<std::string> auto&& PluginNamespace) const {
		auto Namespace = Utility::ExposeCharPointerIfASCIZCompatibleOrDeepCopyIfNot(PluginNamespace);
		auto NamespacePointer = Utility::ExtractCharPointerFromASCIZFormattedString(Namespace);
		auto PluginHandle = UniversalContext::API->getPluginByNamespace(NamespacePointer, Handle);
		if (PluginHandle == nullptr)
			throw std::runtime_error{ "Core: plugin namespace was not found." };
		auto Descriptor = PluginInfo{
			.Namespace = UniversalContext::API->getPluginNamespace(PluginHandle),
			.Identifier = UniversalContext::API->getPluginID(PluginHandle),
			.Description = UniversalContext::API->getPluginName(PluginHandle)
		};
		auto Path = UniversalContext::API->getPluginPath(PluginHandle);
		return Plugin{ std::move(Descriptor), PluginHandle, Path == nullptr ? std::filesystem::path{} : std::filesystem::path{ Path } };
	}

	explicit operator std::string() const {
		auto StringRepresentation = std::ostringstream{};
		StringRepresentation << static_cast<std::string>(Query()) << "\n---- Plugin List ----";
		for (auto&& [Namespace, Identifier, Description] : ListPlugins())
			StringRepresentation << "\nNamespace: " << Namespace << " | Identifier: " << Identifier << " | Description: " << Description;
		return StringRepresentation.str();
	}
};

struct CoreInstantiator : CoreProxy {
private:
	using CoreReference = ResourceManager::Tracker<VSCore>;

	field(ResourceGuard, std::shared_ptr<CoreReference>{});

public:
	CoreInstantiator() {
		this->Handle = UniversalContext::API->createCore(0);
		this->ResourceGuard = std::make_shared<CoreReference>(this->Handle);
	}
};
