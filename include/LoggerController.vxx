#pragma once
#include "ResourceManager.vxx"

struct VSLogHandle {};

struct LoggerController {
	field(Handle, static_cast<VSLogHandle*>(nullptr));
	field(Core, static_cast<VSCore*>(nullptr));

public:
	auto Eject() const {
		if (Handle == nullptr || Core == nullptr)
			return false;
		return UniversalContext::API->removeLogHandler(Handle, Core) != 0;
	}
	operator auto() const {
		return Handle;
	}
};
