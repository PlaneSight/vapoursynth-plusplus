#pragma once

#include "API4Extensions.vxx"

namespace PluginInstantiator::Private {
	inline auto Configurator = static_cast<const VSPLUGINAPI*>(nullptr);
	inline auto Handle = static_cast<VSPlugin*>(nullptr);
	inline auto Recycler = ResourceManager::GarbageCollector{};
}

namespace PluginInstantiator {
	template<typename>
	inline constexpr auto AlwaysFalse = false;

	inline auto FilterMode(auto Policy) {
		if constexpr (std::same_as<std::decay_t<decltype(Policy)>, VSFilterMode>)
			return static_cast<int>(Policy);
		else {
			switch (Policy) {
				case ExecutionSchemes::FullyParallel: return static_cast<int>(fmParallel);
				case ExecutionSchemes::ParallelResourceAcquisition: return static_cast<int>(fmParallelRequests);
				case ExecutionSchemes::Concurrent: return static_cast<int>(fmUnordered);
				case ExecutionSchemes::OneFrameAtATime: return static_cast<int>(fmFrameState);
			}
			throw std::runtime_error{ "PluginInstantiator: unknown filter execution policy." };
		}
	}

	auto ConfigureFilterNode(auto& Filter, VSNode* Node) -> void {
		using FilterType = std::decay_t<decltype(Filter)>;
		const auto LinearAccess = [&] {
			if constexpr (requires { Filter.SpecifyLinearAccess(); })
				return static_cast<bool>(Filter.SpecifyLinearAccess());
			else if constexpr (requires { FilterType::LinearAccess; })
				return static_cast<bool>(FilterType::LinearAccess);
			else
				return false;
		}();
		if (LinearAccess)
			API4::EnableLinearAccess(Node);

		const auto CachePolicy = [&] {
			if constexpr (requires { Filter.SpecifyCachePolicy(); })
				return Filter.SpecifyCachePolicy();
			else if constexpr (requires { FilterType::CachePolicy; })
				return FilterType::CachePolicy;
			else
				return CacheOptions::Automatic;
		}();
		using CachePolicyType = std::decay_t<decltype(CachePolicy)>;
		if constexpr (std::same_as<CachePolicyType, CacheOptions>) {
			if (!LinearAccess || CachePolicy == CacheOptions::Disabled)
				API4::SetCacheMode(Node, CachePolicy == CacheOptions::Disabled ? CacheModes::Disabled : CacheModes::Automatic);
		}
		else if constexpr (std::same_as<CachePolicyType, CacheModes>) {
			if (!LinearAccess || CachePolicy != CacheModes::Automatic)
				API4::SetCacheMode(Node, CachePolicy);
		}
		else if constexpr (std::same_as<CachePolicyType, API4::CacheConfiguration>) {
			if (!LinearAccess)
				API4::SetCacheMode(Node, CacheModes::Automatic);
			API4::ConfigureCache(Node, CachePolicy);
		}
		else if constexpr (std::same_as<CachePolicyType, API4::CachePolicy>) {
			if (!LinearAccess || CachePolicy.Mode != CacheModes::Automatic)
				API4::SetCacheMode(Node, CachePolicy.Mode);
			API4::ConfigureCache(Node, CachePolicy.Options);
		}
		else
			static_assert(AlwaysFalse<CachePolicyType>, "PluginInstantiator: SpecifyCachePolicy() must return CacheOptions, API4::CacheModes, API4::CacheConfiguration, or API4::CachePolicy.");
	}

	template<typename FilterType>
	auto FilterReturnSignature() {
		if constexpr (requires { FilterType::ReturnSignature; })
			return static_cast<std::string>(FilterType::ReturnSignature);
		else
			return "clip:vnode;"s;
	}

	auto FunctionReturnSignature(ExplicitlyConvertibleTo<std::string> auto&& Signature) {
		auto ReferenceSignature = static_cast<std::string>(Forward(Signature));
		if (auto ReturnMarker = ReferenceSignature.find("->"); ReturnMarker != std::string::npos)
			return ReferenceSignature.substr(ReturnMarker + 2) + (ReferenceSignature.back() == ';' ? ""s : ";"s);
		return "val:data;"s;
	}

	template<typename FilterType>
	auto RegisterFilter(auto&& ...Configurations) requires (sizeof...(Configurations) < 2) {
		auto ConfigurationHandle = new std::tuple{ ""s, Forward(Configurations)... };
		using ConfigurationType = std::decay_t<decltype(*ConfigurationHandle)>;
		auto Signature = [&] {
			auto CarryOnRegardless = [&](auto...) {
				if constexpr (requires { FilterType::SpecifySignature(); })
					return static_cast<std::string>(FilterType::SpecifySignature());
				else if constexpr (requires { FilterType::Signature; })
					return static_cast<std::string>(FilterType::Signature);
				else
					static_assert(sizeof(FilterType) == -1, "RegisterFilter: the filter has no signature.");
			};
			if constexpr (sizeof...(Configurations) > 0) {
				if constexpr (requires { FilterType::SpecifySignature(std::get<1>(*ConfigurationHandle)); })
					return static_cast<std::string>(FilterType::SpecifySignature(std::get<1>(*ConfigurationHandle)));
				else
					return CarryOnRegardless();
			}
			else
				return CarryOnRegardless();
		}();
		std::get<0>(*ConfigurationHandle) = Utility::SignatureParser::DeduceFunctionName(Signature, Utility::Reflection::ReifyTypeNameIntoString<FilterType>());

		using ExtendedFilterType = std::pair<std::string, FilterType>;

		auto FilterEngine = [](const VSMap* ArgumentMap, VSMap* OutputMap, void* ConfigurationPointer, VSCore* CoreHandle, const VSAPI* API) VS_CC {
			UniversalContext::InstallAPI(API);
			auto Arguments = ArgumentList{ .Handle = ArgumentMap };
			auto Console = ConsoleProxy{ .Handle = OutputMap };
			auto Core = CoreProxy{ .Handle = CoreHandle };
			auto* Configuration = static_cast<ConfigurationType*>(ConfigurationPointer);

			auto FilterInstantiator = [&](auto&& FilterArguments) {
				auto Construct = [&] {
					if constexpr (sizeof...(Configurations) > 0) {
						if constexpr (std::constructible_from<FilterType, decltype(FilterArguments), decltype((std::get<1>(*Configuration))), decltype((Core))>)
							return FilterType{ FilterArguments, std::get<1>(*Configuration), Core };
						else if constexpr (std::constructible_from<FilterType, decltype(FilterArguments), decltype((std::get<1>(*Configuration)))>)
							return FilterType{ FilterArguments, std::get<1>(*Configuration) };
						else if constexpr (std::constructible_from<FilterType, decltype(FilterArguments), decltype((Core))>)
							return FilterType{ FilterArguments, Core };
						else if constexpr (std::constructible_from<FilterType, decltype(FilterArguments)>)
							return FilterType{ FilterArguments };
						else if constexpr (std::default_initializable<FilterType>)
							return FilterType{};
						else
							static_assert(std::default_initializable<FilterType>, "RegisterFilter: the filter has no supported constructor.");
					}
					else if constexpr (std::constructible_from<FilterType, decltype(FilterArguments), decltype((Core))>)
						return FilterType{ FilterArguments, Core };
					else if constexpr (std::constructible_from<FilterType, decltype(FilterArguments)>)
						return FilterType{ FilterArguments };
					else if constexpr (std::default_initializable<FilterType>)
						return FilterType{};
					else
						static_assert(std::default_initializable<FilterType>, "RegisterFilter: the filter has no supported constructor.");
				};
				return std::make_unique<ExtendedFilterType>(std::get<0>(*Configuration), Construct());
			};

			auto CreateFilter = [&](std::unique_ptr<ExtendedFilterType> FilterInstance, VSMap* TargetOutput) {
				auto& FilterName = FilterInstance->first;
				auto& Filter = FilterInstance->second;
				auto Metadata = [&] {
					if constexpr (requires { Filter.SpecifyMetadata(Core); })
						return Filter.SpecifyMetadata(Core);
					else if constexpr (requires { Filter.SpecifyMetadata(); })
						return Filter.SpecifyMetadata();
					else
						static_assert(sizeof(FilterType) == -1, "RegisterFilter: SpecifyMetadata() is missing or has an incompatible signature.");
				}();
				auto Dependencies = [&] {
					auto Result = std::vector<VSFilterDependency>{};
					if constexpr (requires { Filter.SpecifyDependencies(); }) {
						auto SpecifiedDependencies = Filter.SpecifyDependencies();
						if constexpr (AnyOf<decltype(SpecifiedDependencies), VSFilterDependency>)
							Result.push_back(SpecifiedDependencies);
						else
							for (auto&& Dependency : SpecifiedDependencies)
								Result.push_back(Dependency);
					}
					return Result;
				}();
				auto ExecutionPolicy = [&] {
					if constexpr (requires { Filter.SpecifyExecutionPolicyForFrameGenerator(); })
						return FilterMode(Filter.SpecifyExecutionPolicyForFrameGenerator());
					else if constexpr (requires { FilterType::ExecutionPolicyForFrameGenerator; })
						return FilterMode(FilterType::ExecutionPolicyForFrameGenerator);
					else
						return static_cast<int>(fmParallel);
				}();
				auto FrameGenerator = [](int Index, int ActivationReason, void* InstancePointer, void**, VSFrameContext* FrameContext, VSCore* CoreHandle, const VSAPI* API) VS_CC -> const VSFrame* {
					UniversalContext::InstallAPI(API);
					if (ActivationReason == arError)
						return Frame::NullHandle;
					auto* ExtendedInstance = static_cast<ExtendedFilterType*>(InstancePointer);
					auto& Filter = ExtendedInstance->second;
					auto GeneratorContext = FrameGenerator::ContextProxy{ .Handle = FrameContext, .Status = ActivationReason };
					auto Core = CoreProxy{ .Handle = CoreHandle };
					auto Generate = [&]() -> FrameReference {
						if constexpr (requires { { Filter.GenerateFrame(Index, GeneratorContext, Core) }->SubtypeOf<FrameReference>; })
							return Filter.GenerateFrame(Index, GeneratorContext, Core);
						else if constexpr (requires { { Filter.GenerateFrame(Index, Core) }->SubtypeOf<FrameReference>; })
							return Filter.GenerateFrame(Index, Core);
						else if constexpr (requires { { Filter.GenerateFrame(Core) }->SubtypeOf<FrameReference>; })
							return Filter.GenerateFrame(Core);
						else
							static_assert(sizeof(FilterType) == -1, "RegisterFilter: GenerateFrame() is missing or has an incompatible signature.");
					};
					try {
						return Utility::PointerQualifiers::AddConst(Generate().Leak());
					}
					catch (const FrameGenerator::ResourceAcquisitionInProgress&) {
						return Frame::NullHandle;
					}
					catch (const std::exception& ErrorMessage) {
						return GeneratorContext.RaiseError(ExtendedInstance->first + ": " + ErrorMessage.what());
					}
				};
				auto FilterRecycler = [](void* InstancePointer, VSCore*, const VSAPI* API) VS_CC {
					UniversalContext::InstallAPI(API);
					delete static_cast<ExtendedFilterType*>(InstancePointer);
				};

				if constexpr (AnyOf<decltype(Metadata), VideoInfo, VSVideoInfo>) {
					auto VideoMetadata = VideoInfo::AdjustToLegacyLayout(Metadata, Core);
					auto InstancePointer = FilterInstance.get();
					auto Node = API->createVideoFilter2(FilterName.data(), &VideoMetadata, FrameGenerator, FilterRecycler, ExecutionPolicy, Dependencies.data(), static_cast<int>(Dependencies.size()), InstancePointer, CoreHandle);
					if (Node == nullptr)
						throw std::runtime_error{ "failed to create the video filter node." };
					FilterInstance.release();
					ConfigureFilterNode(Filter, Node);
					if (API->mapConsumeNode(TargetOutput, "clip", Node, maAppend) != 0)
						throw std::runtime_error{ "failed to publish the video filter node." };
				}
				else if constexpr (AnyOf<decltype(Metadata), AudioInfo, VSAudioInfo>) {
					auto AudioMetadata = AudioInfo::AdjustToLegacyLayout(Metadata, Core);
					auto InstancePointer = FilterInstance.get();
					auto Node = API->createAudioFilter2(FilterName.data(), &AudioMetadata, FrameGenerator, FilterRecycler, ExecutionPolicy, Dependencies.data(), static_cast<int>(Dependencies.size()), InstancePointer, CoreHandle);
					if (Node == nullptr)
						throw std::runtime_error{ "failed to create the audio filter node." };
					FilterInstance.release();
					ConfigureFilterNode(Filter, Node);
					if (API->mapConsumeNode(TargetOutput, "clip", Node, maAppend) != 0)
						throw std::runtime_error{ "failed to publish the audio filter node." };
				}
				else if constexpr (Iterable<decltype(Metadata)>) {
					static_assert(sizeof(FilterType) == -1, "RegisterFilter: API 4 filters must create one output node per function call.");
				}
				else
					static_assert(sizeof(FilterType) == -1, "RegisterFilter: only video filter metadata is currently supported by the adapter.");
			};

			try {
				auto Workflow = [&](auto&& ...WorkflowArguments) {
					auto ArgumentMap = Utility::Map::Create();
					auto ResultMap = Utility::Map::Create();
					if constexpr (sizeof...(WorkflowArguments) != 0)
						Utility::Map::Fill(ArgumentMap.Handle, Forward(WorkflowArguments)...);
					CreateFilter(FilterInstantiator(ArgumentList{ .Handle = ArgumentMap.Handle }), ResultMap.Handle);
					return Utility::Map::Item<true, false>{ ResultMap.Leak(), "clip" };
				};
				if constexpr (requires { FilterType::InitiateWorkflow(Workflow, Arguments, Core); })
					Console.Receive("clip", FilterType::InitiateWorkflow(Workflow, Arguments, Core));
				else if constexpr (requires { FilterType::InitiateWorkflow(Workflow, Arguments); })
					Console.Receive("clip", FilterType::InitiateWorkflow(Workflow, Arguments));
				else if constexpr (requires { FilterType::InitiateWorkflow(Workflow); })
					Console.Receive("clip", FilterType::InitiateWorkflow(Workflow));
				else
					CreateFilter(FilterInstantiator(Arguments), OutputMap);
			}
			catch (const std::exception& ErrorMessage) {
				Console.RaiseError(std::get<0>(*Configuration) + ": " + ErrorMessage.what());
			}
		};

		Private::Recycler.ClaimOwnership(ConfigurationHandle);
		Private::Configurator->registerFunction(
			std::get<0>(*ConfigurationHandle).data(),
			Utility::SignatureParser::ExtractParameterList(Signature).data(),
			FilterReturnSignature<FilterType>().data(),
			FilterEngine,
			ConfigurationHandle,
			Private::Handle);
	}

	auto RegisterFunction(ExplicitlyConvertibleTo<std::string> auto&& Signature, auto&& FunctionEntity) {
		auto ConfigurationHandle = new std::tuple{ ""s, ""s, Forward(FunctionEntity) };
		using ConfigurationType = std::decay_t<decltype(*ConfigurationHandle)>;
		auto FunctionProxy = [](const VSMap* ArgumentMap, VSMap* OutputMap, void* ConfigurationPointer, VSCore* CoreHandle, const VSAPI* API) VS_CC {
			UniversalContext::InstallAPI(API);
			auto Arguments = ArgumentList{ .Handle = ArgumentMap };
			auto Core = CoreProxy{ .Handle = CoreHandle };
			auto& [FunctionName, ReturnKey, RegisteredFunction] = *static_cast<ConfigurationType*>(ConfigurationPointer);
			auto Invoke = [&] {
				if constexpr (requires { RegisteredFunction(Arguments, Core); })
					return RegisteredFunction(Arguments, Core);
				else if constexpr (requires { RegisteredFunction(Arguments); })
					return RegisteredFunction(Arguments);
				else if constexpr (requires { RegisteredFunction(); })
					return RegisteredFunction();
				else
					static_assert(sizeof(RegisteredFunction) == -1, "RegisterFunction: the specified object has an incompatible signature.");
			};
			try {
				if constexpr (requires { { Invoke() }->AnyBut<void>; })
					Utility::Map::Fill(OutputMap, ReturnKey, Invoke());
				else
					Invoke();
			}
			catch (const std::exception& ErrorMessage) {
				API->mapSetError(OutputMap, (FunctionName + ": " + ErrorMessage.what()).data());
			}
		};
		std::get<0>(*ConfigurationHandle) = Utility::SignatureParser::DeduceFunctionName(Signature);
		std::get<1>(*ConfigurationHandle) = Utility::SignatureParser::DeduceReturnKey(Signature, "val");
		Private::Recycler.ClaimOwnership(ConfigurationHandle);
		Private::Configurator->registerFunction(
			std::get<0>(*ConfigurationHandle).data(),
			Utility::SignatureParser::ExtractParameterList(Signature).data(),
			FunctionReturnSignature(Signature).data(),
			FunctionProxy,
			ConfigurationHandle,
			Private::Handle);
	}

	auto SpecifyConfigurations(SubtypeOf<PluginInfo> auto&& Descriptor, AnyOf<WriteProtectOptions, bool> auto WriteProtection) {
		Private::Configurator->configPlugin(
			Descriptor.Identifier.data(),
			Descriptor.Namespace.data(),
			Descriptor.Description.data(),
			VS_MAKE_VERSION(1, 0),
			VAPOURSYNTH_API_VERSION,
			static_cast<bool>(WriteProtection) == static_cast<bool>(WriteProtectOptions::Rewritable) ? pcModifiable : 0,
			Private::Handle);
	}
	auto SpecifyConfigurations(SubtypeOf<PluginInfo> auto&& Descriptor) {
		SpecifyConfigurations(Forward(Descriptor), WriteProtectOptions::WriteOnce);
	}
}

#define InstantiatePluginFrom(...) VS_EXTERNAL_API(void) VapourSynthPluginInit2(VSPlugin* plugin, const VSPLUGINAPI* vspapi) { \
	PluginInstantiator::Private::Configurator = vspapi; \
	PluginInstantiator::Private::Handle = plugin; \
	__VA_ARGS__(); \
}
