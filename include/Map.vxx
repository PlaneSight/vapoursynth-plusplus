#pragma once
#include "VideoNode.vxx"
#include "AudioNode.vxx"

struct Function;

namespace Utility::Map {
	template<typename TargetType>
	concept InitializerList = requires {
		typename std::remove_cvref_t<TargetType>::value_type;
		requires std::same_as<std::remove_cvref_t<TargetType>, std::initializer_list<typename std::remove_cvref_t<TargetType>::value_type>>;
	};

	template<auto NonOwning = false>
	using Reference = ResourceManager::Tracker<VSMap, NonOwning>;

	template<typename ResourceWrapper>
	auto RenderResource(auto&& Handle) -> std::string {
		return static_cast<std::string>(ResourceWrapper{ Forward(Handle) });
	}

	struct MapData {
		std::string Bytes{};
		DataTypeHints Hint = DataTypeHints::Utf8;

		operator const char*() const { return Bytes.c_str(); }
	};

	template<auto Readonly, auto NonOwning>
	struct Item {
		field(Index, 0z);

	private:
		struct SharedState : Reference<NonOwning> {
			field(Key, ""s);

		public:
			SharedState() = default;
			SharedState(auto&& Handle, auto&& Key) : Reference<NonOwning>{ Forward(Handle) } {
				this->Key = static_cast<std::string>(Forward(Key));
			}
		};

	private:
		struct Iterator {
			field(TargetItem, static_cast<const Item*>(nullptr));
			field(Index, 0z);

		public:
			auto operator*() const {
				return TargetItem->operator[](Index);
			}
			auto& operator++() {
				++Index;
				return *this;
			}
			auto operator!=(auto&& OtherIterator) const {
				return Index != OtherIterator.Index;
			}
		};

	public:
		field(StorageAccess, std::shared_ptr<SharedState>{});

	public:
		Item() = default;
		Item(auto&& Handle, ExplicitlyConvertibleTo<std::string> auto&& Key) {
			this->StorageAccess = std::make_shared<SharedState>(Forward(Handle), Forward(Key));
		}
		Item(std::shared_ptr<SharedState> State, std::ptrdiff_t Index) : Index{ Index }, StorageAccess{ std::move(State) } {}
		Item(const Item&) = default;
		Item(Item&&) = default;
		auto& operator=(const Item&) requires Readonly = delete;
		auto& operator=(Item&&) requires Readonly = delete;

	public:
		auto Type() const {
			return static_cast<ItemTypes>(UniversalContext::API->mapGetType(StorageAccess->Handle, StorageAccess->Key.data()));
		}
		auto IsPresent() const {
			return UniversalContext::API->mapNumElements(StorageAccess->Handle, StorageAccess->Key.data()) >= 0;
		}
		auto IsEmpty() const {
			return IsPresent() && QueryStorageSize() == 0;
		}
		template<Countable IndexType = int>
		auto QueryDataTypeHint(IndexType Index = 0) const -> DataTypeHints {
			auto Error = 0;
			auto Hint = UniversalContext::API->mapGetDataTypeHint(StorageAccess->Handle, StorageAccess->Key.data(), Index, &Error);
			if (Error != peSuccess)
				throw std::runtime_error{ "Map::Item::QueryDataTypeHint: map lookup failed." };
			return static_cast<DataTypeHints>(Hint);
		}
		auto Apply(auto&& PolymorphicFunction) const {
			using enum ItemTypes;
			if (Type() == Int)
				return PolymorphicFunction(static_cast<std::int64_t>(*this));
			else if (Type() == Float)
				return PolymorphicFunction(static_cast<double>(*this));
			else if (Type() == String)
				return PolymorphicFunction([&] {
					if (QueryStorageSize() == 0)
						return MapData{};
					return MapData{
						.Bytes = [&] {
							auto Error = 0;
							auto Size = UniversalContext::API->mapGetDataSize(StorageAccess->Handle, StorageAccess->Key.data(), Index, &Error);
							if (Error != peSuccess)
								throw std::runtime_error{ "Map::Item: failed to query data size." };
							auto Data = UniversalContext::API->mapGetData(StorageAccess->Handle, StorageAccess->Key.data(), Index, &Error);
							if (Error != peSuccess)
								throw std::runtime_error{ "Map::Item: failed to read data." };
							return std::string{ Data, static_cast<std::size_t>(Size) };
						}(),
						.Hint = QueryStorageSize() > Index ? QueryDataTypeHint() : DataTypeHints::Utf8
					};
				}());
			else if (Type() == VideoNode || Type() == AudioNode)
				return PolymorphicFunction(static_cast<NodeReference>(*this));
			else if (Type() == VideoFrame || Type() == AudioFrame)
				return PolymorphicFunction(static_cast<FrameReference>(*this));
			else if (Type() == Function)
				return PolymorphicFunction(static_cast<FunctionReference>(*this));
			else [[unlikely]]
				throw std::runtime_error{ "Item: An ill-formed instance has been detected." };
		}

	public:
		auto Exists() const {
			return Index < QueryStorageSize();
		}
		auto operator[](Countable auto Index) const -> Item {
			return Item{ StorageAccess, static_cast<std::ptrdiff_t>(Index) };
		}
		auto size() const {
			return static_cast<std::size_t>(QueryStorageSize() - Index);
		}
		auto begin() const {
			return Iterator{ .TargetItem = this, .Index = Index };
		}
		auto end() const {
			return Iterator{ .TargetItem = this, .Index = QueryStorageSize() };
		}

	public:
		template<std::floating_point TargetType>
		operator TargetType() const {
			return UniversalContext::API->mapGetFloat(StorageAccess->Handle, StorageAccess->Key.data(), Index, nullptr);
		}

	public:
		template<Countable TargetType>
		operator TargetType() const {
			return static_cast<TargetType>(UniversalContext::API->mapGetInt(StorageAccess->Handle, StorageAccess->Key.data(), Index, nullptr));
		}

	public:
		template<ConstructibleFrom<const char*> TargetType>
		operator TargetType() const {
			return { UniversalContext::API->mapGetData(StorageAccess->Handle, StorageAccess->Key.data(), Index, nullptr) };
		}

	public:
		template<SubtypeOf<NodeReference> TargetType>
		operator TargetType() const {
			return { UniversalContext::API->mapGetNode(StorageAccess->Handle, StorageAccess->Key.data(), Index, nullptr) };
		}

	public:
		template<SubtypeOf<FrameReference> TargetType>
		operator TargetType() const {
			return { UniversalContext::API->mapGetFrame(StorageAccess->Handle, StorageAccess->Key.data(), Index, nullptr) };
		}

	public:
		template<SubtypeOf<FunctionReference> TargetType>
		operator TargetType() const {
			return { UniversalContext::API->mapGetFunction(StorageAccess->Handle, StorageAccess->Key.data(), Index, nullptr) };
		}

	public:
		template<typename TargetType> requires (Iterable<TargetType> && !InitializerList<TargetType>)
		operator TargetType() const requires (
			!std::constructible_from<TargetType, const char*> &&
			!requires(TargetType x) { x.Type(); }
		) {
			using ElementType = std::decay_t<decltype(*TargetType{}.begin()) > ;
			constexpr auto IsNumber = std::floating_point<ElementType> || Countable<ElementType>;
			constexpr auto IsString = ConstructibleFrom<ElementType, const char*>;
			constexpr auto IsIntrinsicObject = AnyOf<ElementType, NodeReference, FrameReference, FunctionReference>;
			static_assert(IsNumber || IsString || IsIntrinsicObject, "Item: cannot convert an item to a container of unrecognized type.");
			if constexpr (std::same_as<ElementType, std::int64_t> && requires(TargetType x) {
				x.resize(std::size_t{});
				x.data();
			}) {
				auto Error = 0;
				auto Data = UniversalContext::API->mapGetIntArray(StorageAccess->Handle, StorageAccess->Key.data(), &Error);
				if (Error != peSuccess)
					throw std::runtime_error{ "Item: failed to read native integer array." };
				auto Result = TargetType{};
				Result.resize(static_cast<std::size_t>(QueryStorageSize()));
				std::copy_n(Data, Result.size(), Result.data());
				return Result;
			}
			if constexpr (std::same_as<ElementType, double> && requires(TargetType x) {
				x.resize(std::size_t{});
				x.data();
			}) {
				auto Error = 0;
				auto Data = UniversalContext::API->mapGetFloatArray(StorageAccess->Handle, StorageAccess->Key.data(), &Error);
				if (Error != peSuccess)
					throw std::runtime_error{ "Item: failed to read native float array." };
				auto Result = TargetType{};
				Result.resize(static_cast<std::size_t>(QueryStorageSize()));
				std::copy_n(Data, Result.size(), Result.data());
				return Result;
			}
			return Utility::ContainerManipulators::MapWithNaturalTransformation<TargetType>([](auto&& x) { return static_cast<ElementType>(x); }, *this);
		}

	private:
		auto QueryStorageSize() const {
			return Utility::Arithmetic::Max(UniversalContext::API->mapNumElements(StorageAccess->Handle, StorageAccess->Key.data()), 0);
		}
		auto Insert(auto&& Entity, auto AppendMode) const {
			constexpr auto IsIterable = Iterable<decltype(Entity)>;
			constexpr auto IsCharArray = std::convertible_to<decltype(Entity), const char*>;
			constexpr auto IsCharContainer = requires{ { *Entity.begin() }->SubtypeOf<char>; };
			auto InjectValue = [this](auto&& Value) {
				using ValueType = std::decay_t<decltype(Value)>;
				if constexpr (std::floating_point<ValueType>)
					UniversalContext::API->mapSetFloat(StorageAccess->Handle, StorageAccess->Key.data(), Value, maAppend);
				else if constexpr (Countable<ValueType>)
					UniversalContext::API->mapSetInt(StorageAccess->Handle, StorageAccess->Key.data(), static_cast<std::int64_t>(Value), maAppend);
				else if constexpr (std::same_as<ValueType, MapData>)
					UniversalContext::API->mapSetData(StorageAccess->Handle, StorageAccess->Key.data(), Value.Bytes.data(), static_cast<int>(Value.Bytes.size()), static_cast<int>(Value.Hint), maAppend);
				else if constexpr (requires { { Value }->ExplicitlyConvertibleTo<const char*>; })
					UniversalContext::API->mapSetData(StorageAccess->Handle, StorageAccess->Key.data(), static_cast<const char*>(Value), -1, dtUtf8, maAppend);
				else if constexpr (requires { { Value.size() }->std::integral; { Value.data() }->std::convertible_to<const char*>; })
					UniversalContext::API->mapSetData(StorageAccess->Handle, StorageAccess->Key.data(), Value.data(), static_cast<int>(Value.size()), dtBinary, maAppend);
				else if constexpr (SubtypeOf<ValueType, NodeReference>)
					UniversalContext::API->mapSetNode(StorageAccess->Handle, StorageAccess->Key.data(), Value.Handle, maAppend);
				else if constexpr (SubtypeOf<ValueType, FrameReference>)
					UniversalContext::API->mapSetFrame(StorageAccess->Handle, StorageAccess->Key.data(), Value.Handle, maAppend);
				else if constexpr (SubtypeOf<ValueType, FunctionReference>)
					UniversalContext::API->mapSetFunction(StorageAccess->Handle, StorageAccess->Key.data(), Value.Handle, maAppend);
				else
					static_assert(sizeof(Value) == -1, "Item: failed to inject an instance of unrecognized type.");
			};
			if (AppendMode == maReplace) {
				Erase();
				if constexpr (Iterable<decltype(Entity)> && !IsCharArray && !IsCharContainer && requires {
						Entity.data();
						Entity.size();
					}) {
					using ElementType = std::decay_t<decltype(*Entity.begin())>;
					if constexpr (std::same_as<ElementType, std::int64_t>) {
						if (UniversalContext::API->mapSetIntArray(StorageAccess->Handle, StorageAccess->Key.data(), Entity.data(), static_cast<int>(Entity.size())) != 0)
							throw std::runtime_error{ "Map::Item: failed to write native integer array." };
						return;
					}
					else if constexpr (std::same_as<ElementType, double>) {
						if (UniversalContext::API->mapSetFloatArray(StorageAccess->Handle, StorageAccess->Key.data(), Entity.data(), static_cast<int>(Entity.size())) != 0)
							throw std::runtime_error{ "Map::Item: failed to write native float array." };
						return;
					}
				}
			}
			if constexpr (requires { { Entity.Type() }->SubtypeOf<ItemTypes>; })
				for (auto&& x : Entity)
					x.Apply(InjectValue);
			else if constexpr (IsIterable && !IsCharArray && !IsCharContainer)
				for (auto&& x : Entity)
					InjectValue(x);
			else
				InjectValue(Entity);
		}

	public:
		auto Erase() const requires (Readonly == false) {
			return UniversalContext::API->mapDeleteKey(StorageAccess->Handle, StorageAccess->Key.data()) == 1;
		}
		template<SubtypeOf<NodeReference> Resource>
		auto Consume(Resource&& Value) const requires (Readonly == false) {
			return UniversalContext::API->mapConsumeNode(StorageAccess->Handle, StorageAccess->Key.data(), Value.Leak(), maAppend) == 0;
		}
		template<SubtypeOf<FrameReference> Resource>
		auto Consume(Resource&& Value) const requires (Readonly == false) {
			return UniversalContext::API->mapConsumeFrame(StorageAccess->Handle, StorageAccess->Key.data(), Value.Leak(), maAppend) == 0;
		}
		template<SubtypeOf<FunctionReference> Resource>
		auto Consume(Resource&& Value) const requires (Readonly == false) {
			return UniversalContext::API->mapConsumeFunction(StorageAccess->Handle, StorageAccess->Key.data(), Value.Leak(), maAppend) == 0;
		}
		auto& operator=(auto&& Entity) const requires (Readonly == false) {
			if constexpr (requires { { Entity.Type() }->SubtypeOf<ItemTypes>; })
				if (Entity.StorageAccess->Handle == StorageAccess->Handle && Entity.StorageAccess->Key == StorageAccess->Key)
					return *this;
			Insert(Entity, maReplace);
			return *this;
		}
		auto& operator+=(auto&& Entity) const requires (Readonly == false) {
			Insert(Entity, maAppend);
			return *this;
		}
	};

	auto Create() -> Reference<> {
		return Reference<>{ UniversalContext::API->createMap() };
	}
	auto ListKeys(const VSMap* MapHandle) -> std::vector<std::string_view> {
		auto ItemCount = UniversalContext::API->mapNumKeys(MapHandle);
		auto Keys = std::vector<std::string_view>{};
		Keys.resize(ItemCount);
		for (auto x : Range{ ItemCount })
			Keys[x] = UniversalContext::API->mapGetKey(MapHandle, x);
		return Keys;
	}
	auto Fill(auto MapHandle, auto&& Key, auto&& Values, auto&& ...Arguments) -> void {
		auto ItemStorage = Item<false>{ MapHandle, Forward(Key) };
		ItemStorage += Values;
		if constexpr (sizeof...(Arguments) != 0)
			Fill(MapHandle, Forward(Arguments)...);
	}
	auto CheckForError(const VSMap* MapHandle) -> std::tuple<bool, const char*> {
		auto ErrorMessage = UniversalContext::API->mapGetError(MapHandle);
		return std::tuple{ ErrorMessage != nullptr, ErrorMessage };
	}
	auto DeduceReturnKey(const VSMap* MapHandle, std::string_view Fallback) -> std::string_view {
		if (auto CandidateKeys = ListKeys(MapHandle); CandidateKeys.size() == 1) [[likely]]
			return CandidateKeys[0];
		else
			return Fallback;
	}
	auto PrintItem(auto&& ItemInstance)->std::string {
		auto GenerateStringRepresentation = [](auto&& Value) {
			auto IndentStructuredRepresentation = [](auto&& RepresentationString) {
				return std::regex_replace("{\n" + std::move(RepresentationString), std::regex{ "\n" }, "\n    ") + "\n}";
			};
			if constexpr (std::same_as<std::decay_t<decltype(Value)>, MapData>)
				return "\""s + Value.Bytes + "\"";
			else if constexpr (requires { std::to_string(Value); })
				return std::to_string(Value);
			else if constexpr (requires { { Value }->std::convertible_to<const char*>; })
				return "\""s + Value + "\"";
			else if constexpr (requires { { Value }->SubtypeOf<NodeReference>; })
				return IndentStructuredRepresentation(static_cast<std::string>(Node{ Value.Leak() }));
			else if constexpr (requires { { Value }->SubtypeOf<FrameReference>; })
				return IndentStructuredRepresentation(static_cast<std::string>(Frame{ Value.Leak() }));
			else if constexpr (requires { { Value }->SubtypeOf<FunctionReference>; })
				return IndentStructuredRepresentation(RenderResource<Function>(Value.Leak()));
		};
		if (ItemInstance.size() > 1) {
			auto StringRepresentation = "["s;
			for (auto&& x : ItemInstance)
				StringRepresentation += x.Apply(GenerateStringRepresentation) + ", ";
			return StringRepresentation.erase(StringRepresentation.size() - 2) + "]";
		}
		else if (ItemInstance.Exists())
			return ItemInstance.Apply(GenerateStringRepresentation);
		else
			return "nullptr";
	}
}

#include "Function.vxx"

struct ArgumentList {
	field(Handle, static_cast<const VSMap*>(nullptr));

public:
	auto ListSpecifiedParameters() const {
		return Utility::Map::ListKeys(Handle);
	}
	auto operator[](ExplicitlyConvertibleTo<std::string> auto&& Parameter) const {
		return Utility::Map::Item{ Handle, Forward(Parameter) };
	}

public:
	explicit operator std::string() const {
		auto StringRepresentation = std::ostringstream{};
		for (auto&& x : ListSpecifiedParameters())
			StringRepresentation << "\n" << x << ": " << Utility::Map::PrintItem(operator[](x));
		return StringRepresentation.str().erase(0, 1);
	}
};

struct ConsoleProxy {
	field(Handle, static_cast<VSMap*>(nullptr));

public:
	auto Receive(ExplicitlyConvertibleTo<std::string> auto&& Key, auto&& Value) const {
		Utility::Map::Fill(Handle, Forward(Key), Forward(Value));
	}
	auto RaiseError(ExplicitlyConvertibleTo<std::string> auto&& FormattedErrorMessage) const {
		auto ErrorMessage = Utility::ExposeCharPointerIfASCIZCompatibleOrDeepCopyIfNot(FormattedErrorMessage);
		UniversalContext::API->mapSetError(Handle, Utility::ExtractCharPointerFromASCIZFormattedString(ErrorMessage));
	}
};
